diff --git a/Makefile b/Makefile
index d2238823..83f2f7ce 100755
--- a/Makefile
+++ b/Makefile
@@ -216,6 +216,77 @@ export MPY_CFLAGS
 export MPY_MKARGS
 export USERMOD_OPT
 
+# Standalone USB Video Class firmware.  The UVC sources were still shipped in
+# v4.7.0, but their top-level build target had been dropped.  Keep this target
+# deliberately separate from the MicroPython firmware so it can be linked as a
+# small, native USB camera application at OMV_FIRM_ADDR.
+UVC_DIR := ports/stm32/uvc
+UVC_BUILD := $(BUILD)/$(UVC_DIR)
+UVC_CFLAGS := -I$(TOP_DIR)/$(UVC_DIR)/include $(CFLAGS) \
+              -DOMV_UVC_FIRMWARE=1 -DUSE_USB_FS=1 -DUSE_DEVICE_MODE=1 \
+              -DOMV_UVC_TEST_PATTERN=0
+UVC_LDFLAGS := -mthumb \
+               -mcpu=$(CPU) \
+               -mfpu=$(FPU) \
+               -mfloat-abi=hard \
+               -mabi=aapcs-linux \
+               -nostartfiles \
+               -Wl,--print-memory-usage \
+               -Wl,--gc-sections \
+               -Wl,-T$(UVC_BUILD)/stm32.lds \
+               -Wl,-Map=$(UVC_BUILD)/uvc.map
+
+UVC_SRC_C := $(wildcard $(UVC_DIR)/src/*.c)
+UVC_OBJ := $(addprefix $(BUILD)/,$(UVC_SRC_C:.c=.o))
+UVC_OBJ += $(addprefix $(BUILD)/lib/cmsis/src/, \
+	$(STARTUP).o \
+	$(SYSTEM).o \
+)
+UVC_OBJ += $(wildcard $(BUILD)/lib/stm32/$(MCU_SERIES)/src/*.o)
+UVC_OBJ += $(addprefix $(BUILD)/common/, \
+	array.o \
+	fb_alloc.o \
+	mutex.o \
+	omv_csi.o \
+	unaligned_memcpy.o \
+	vospi.o \
+)
+UVC_OBJ += $(wildcard $(BUILD)/drivers/sensors/*.o)
+UVC_OBJ += $(wildcard $(BUILD)/drivers/lepton/src/*.o)
+UVC_OBJ += $(wildcard $(BUILD)/drivers/pixart/src/*.o)
+UVC_OBJ += $(addprefix $(BUILD)/lib/imlib/, \
+	bayer.o \
+	framebuffer.o \
+	fmath.o \
+	imlib.o \
+	jpege.o \
+	rainbow_tab.o \
+	yuv.o \
+)
+UVC_OBJ += $(addprefix $(BUILD)/ports/stm32/, \
+	dma_utils.o \
+	jpeg.o \
+	omv_csi.o \
+	omv_gpio.o \
+	omv_i2c.o \
+	omv_spi.o \
+	stm32_hal_msp.o \
+)
+UVC_OBJ += $(BUILD)/lib/micropython/pins_$(TARGET).o
+
+.PHONY: uvc UVC_OBJS
+UVC_OBJS:
+	$(MAKE) -C $(UVC_DIR) BUILD=$(UVC_BUILD) CFLAGS="$(UVC_CFLAGS) -MMD"
+
+uvc: UVC_OBJS
+	$(CPP) -P -E -I$(COMMON_DIR) -I$(OMV_BOARD_CONFIG_DIR) \
+		$(UVC_DIR)/stm32.ld.S > $(UVC_BUILD)/stm32.lds
+	$(CC) $(UVC_LDFLAGS) $(UVC_OBJ) -o $(FW_DIR)/uvc.elf -lm
+	$(OBJCOPY) -Obinary $(FW_DIR)/uvc.elf $(FW_DIR)/uvc.bin
+	$(PYTHON) $(MKDFU) -D $(DFU_DEVICE) \
+		-b $(OMV_FIRM_ADDR):$(FW_DIR)/uvc.bin $(FW_DIR)/uvc.dfu
+	$(SIZE) $(FW_DIR)/uvc.elf
+
 clean:
 	$(RM) -fr $(BUILD)
 
